CONFIG_ENV=config.env

KERNEL_SOURCE=https://github.com/Lafactorial/android_kernel_xiaomi_msm8953
KERNEL_SOURCE_BRANCH=evo
KERNEL_CONFIG=tissot_defconfig
ARCH=arm64
KERNEL_FILE=Image
EXTRA_BUILD_COMMAND:LD=ld.lld LLVM=1 LLVM_IAS=1 
DISABLE-LTO=false
ENABLE_KERNELSU=true
APPLY_KSU_PATCH=true
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
ENABLE_SUSFS=false
SUSFS_SOURCE_BRANCH=kernel-4.9
APPLY_SUSFS_PATCH=true
USE_LOCAL_SUSFS_PATCH=false
ADD_SUSFS_CONFIG=true
DISABLE_CC_WERROR=true
SOURCE_BOOT_IMAGE=https://files.catbox.moe/g83jnf.img
